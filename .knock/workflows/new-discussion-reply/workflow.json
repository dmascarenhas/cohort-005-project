{
  "name": "New Discussion Reply",
  "description": "Someone other than the course's owner replied to this person's Discussion Question. Sent by Cadence to the asker; data is { actorName, lessonTitle, url }.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "{{ data.url }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    }
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "new-discussion-reply",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
