{
  "name": "Course rated",
  "description": "A Student rated the course for the first time. Sent by Cadence to the course's owner; data is { actorName, courseTitle, rating, url }.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "{{ data.url }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    }
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "course-rated",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
