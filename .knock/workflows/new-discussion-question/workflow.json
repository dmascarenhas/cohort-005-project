{
  "name": "New Discussion Question",
  "description": "Someone other than the course's owner asked a Discussion Question on one of their lessons. Sent by Cadence to the owner; data is { actorName, lessonTitle, courseTitle, url }.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "action_url": "{{ data.url }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    },
    {
      "type": "channel",
      "template": {
        "subject": "New question on {{ data.lessonTitle }}",
        "settings": {
          "layout_key": "default",
          "attachment_key": "attachments"
        },
        "html_body@": "email_1/html_body.html"
      },
      "ref": "email_1",
      "channel_type": "email",
      "channel_key": "knock-email"
    }
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "new-discussion-question",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
